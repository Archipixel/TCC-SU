datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  role      String   @default("user")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model News{
  id Int @id @default(autoincrement())
  title String @unique
  slug String @unique
  excerpt String?
  content String 
  coverImage String?
  status String @default("RASCUNHO") //depois tem que alterar a logica porque ele por padrão nao fica com a data quando é criado, ele fica escrito RASCUNHO e nao aparece na paginacao
  publishedAt DateTime?              
  authorId String                    //deixei assim pq ainda não tem usuarios pra eu linkar eles com a outra tabela...
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model SystemLog {
  id        String   @id @default(uuid())
  action    String
  details   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("system_logs")
}
